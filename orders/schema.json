{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "granite-retouch Order",
  "type": "object",
  "properties": {
    "order_id": { "type": "string", "pattern": "^ORD-\\d{4}-\\d{3}$" },
    "crm_company_id": {
      "type": "string",
      "pattern": "^CMP-\\d{4}$",
      "description": "ID компании в granite-crm (формат: CMP-NNNN, опционально)"
    },
    "client": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" }
      }
    },
    "machine_type": { "type": "string", "enum": ["laser_standard", "laser_80w", "impact"], "description": "Тип станка. laser_standard — маломощный лазер (20-40W), laser_80w — мощный лазер (60-80W+), impact — ударно-точечный" },
    "machine_model": { "type": "string" },
    "source_photo": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["new", "analyzing", "prompting", "generating", "postprocessing", "done"]
    },
    "analyzer_output": {
      "type": "object",
      "properties": {
        "clothing_style": { "type": "string", "enum": ["civilian", "military", "preserve"] },
        "fabric_type": { "type": "string" },
        "headgear": { "type": "string", "enum": ["none", "cap", "preserve"] },
        "face_quality": { "type": "string", "enum": ["high", "medium", "low"] },
        "defects": { "type": "array", "items": { "type": "string"} }
      }
    },
    "final_prompt": { "type": "string" },
    "generated_image": { "type": "string" },
    "postprocessing": {
      "type": "object",
      "properties": {
        "gimp_processed": { "type": "string" }
      }
    },
    "final_file": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "required": ["order_id", "machine_type", "source_photo", "status"]
}
