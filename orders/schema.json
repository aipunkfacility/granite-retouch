{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "granite-retouch Order",
  "type": "object",
  "properties": {
    "order_id": { "type": "string", "pattern": "^ORD-\\d{4}-\\d{3}$" },
    "crm_company_id": {
      "type": "string",
      "pattern": "^CMP-\\d{4}$",
      "description": "ID компании в granite-crm (формат: CMP-NNNN, опционально)"
    },
    "client": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" }
      }
    },
    "machine_type": { "type": "string", "enum": ["laser_standard", "laser_80w", "impact"], "description": "Тип станка. laser_standard — маломощный лазер (20-40W), laser_80w — мощный лазер (60-80W+), impact — ударно-точечный" },
    "machine_model": { "type": "string" },
    "source_photo": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["new", "analyzing", "prompting", "generating", "postprocessing", "done"]
    },
    "analyzer_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clothing_style": { "type": "string", "enum": ["civilian", "military", "preserve"] },
        "headgear": { "type": "string", "enum": ["none", "present"] },
        "composition": { "type": "string", "enum": ["portrait", "half_body", "full_body"] },
        "composition_changed": { "type": "boolean", "default": false, "description": "true = оператор заказал изменение композиции, вставить composition-блок. false (по умолчанию) = композиция не меняется, блок не вставляется." },
        "photo_angle": { "type": "string", "enum": ["frontal", "3/4", "profile"] },
        "facing_direction": { "type": "string", "enum": ["left", "right", "center"] },
        "garments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tone": { "type": "string", "enum": ["light", "medium", "dark", "very_dark"] },
              "type": { "type": "string" },
              "details": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            },
            "required": ["tone", "type", "details"]
          }
        },
        "body_details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "location":    {"type": "string"},
              "type":        {"type": "string"},
              "description": {"type": "string"}
            },
            "required": ["location", "type", "description"]
          }
        }
      },
      "required": ["clothing_style", "headgear", "composition", "photo_angle", "facing_direction", "garments"]
    },
    "final_prompt": { "type": "string" },
    "generated_image": { "type": "string" },
    "postprocessing": {
      "type": "object",
      "properties": {
        "gimp_processed": { "type": "string" }
      }
    },
    "final_file": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "required": ["order_id", "machine_type", "source_photo", "status"]
}
